VITE_KAKAO_JS_KEY=your_kakao_javascript_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_LOGIN_USERNAME=dulzip
VITE_LOGIN_PASSWORD=gangnam60

FILTER_COMPLEX_MODE=officetel_only
FILTER_COMPLEX_EXCLUDE_KEYWORDS=
MIN_HOUSEHOLDS=0
HOUSEHOLD_ALLOWED_CLASSIFICATIONS=아파트

# Optional modes:
# - officetel_only          (기본값) 오피스텔·근린 상 가형 단지 이름 제외
# - officetel_and_villa     오피스텔 규칙 + 연립/빌라/주상복합까지 단지 이름에서 제외
# - none                    단지 이름으로 추가 제외 없음

# Optional. data/households.csv에 세대수 자료를 넣으면 지도에서 세대수 필터를 사용할 수 있습니다.
# MIN_HOUSEHOLDS=300 처럼 설정하면 데이터 생성 단계에서 300세대 미만/미확인 단지를 제외합니다.

# Optional. If omitted, the data script uses the next weekday at 10:00 in Asia/Seoul.
# TRANSIT_DEPARTURE_ISO=2026-05-04T10:00:00+09:00

# Optional. Python preprocess (npm run data:preprocess → data/preprocessed/trades-with-households.csv).
# When that file exists, npm run data:build skips scanning every root *.csv again.
# PREPROCESSED_TRADES_PATH=data/preprocessed/trades-with-households.csv
# DATA_SKIP_PYTHON_MERGE=1
